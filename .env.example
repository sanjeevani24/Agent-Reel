# Copy to .env and fill in. NEVER commit .env.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1

# Optional generation settings
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_S=60
LLM_REASONING_EFFORT=low

# Optional pricing (USD per 1M tokens) from Groq's pricing page.
# Leave blank and cost is recorded as "unknown" - it is never guessed.
LLM_PRICE_IN_PER_M=
LLM_PRICE_OUT_PER_M=
